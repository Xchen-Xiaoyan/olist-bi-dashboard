{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "late_review",
  "position": {
    "x": 20,
    "y": 170,
    "z": 6,
    "width": 410,
    "height": 270
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "lateness_bucket"
                }
              },
              "queryRef": "fact_orders.lateness_bucket",
              "nativeQueryRef": "lateness_bucket",
              "displayName": "送达时效"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "指标"
                    }
                  },
                  "Property": "平均评分"
                }
              },
              "queryRef": "指标.平均评分",
              "nativeQueryRef": "平均评分"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'送达时效 vs 平均评分'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#252423'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}